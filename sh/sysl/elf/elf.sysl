module sh.sysl.elf

// An ELF file, read from bytes the caller already has: the file header, the program headers
// (segments), the section headers with their names, and the symbol table. Both classes (ELF-32 and
// ELF-64), both byte orders, and every machine and file type read the same way; the numbers that
// differ between them (a 32-bit address, a big-endian half-word) are widened and turned round here,
// so a caller sees one `Segment` and one `Symbol` whatever the file was.
//
// **`read` checks everything it will later index**: the header's own size, and that the program and
// section header tables lie within the file. A segment's or section's *contents* are checked when
// they are asked for (`segment_bytes`, `section_bytes`), so a file with one bad section can still be
// read for the rest. Nothing is copied: names and contents are views of the caller's bytes.
//
// **`load` places a file's segments in memory the caller owns**, described as regions, at the address
// the `place_by` option names, and zeroes the part of each segment the file has no bytes for, except
// where that would write over the image: a segment placed by load address whose run address differs
// (`.bss` of a program linked to run from flash) gets only its file bytes. It checks every segment before it writes any, so memory is untouched when a file is refused.
//
// **The options `elf32`, `elf64`, `little_endian` and `big_endian` choose the formats read.** Each is a
// constant, so a test of one that is off folds to `false` and what it guarded is not in the build.
//
// The specification is the System V gABI's "Object Files" chapter (file header, sections, symbol
// table, program header); field names below are its, without their `e_`/`p_`/`sh_`/`st_` prefixes.

import sysl.buf.{Buf, buf}

// Why a file could not be read.
enum ElfError
    // The first four bytes are not 0x7F 'E' 'L' 'F'.
    NotElf = 0
    // The class byte is neither ELF-32 nor ELF-64, or the data byte neither byte order.
    BadIdent
    // The file ends inside its header, or a table or a piece of content runs past its end.
    Truncated
    // A table's entries are smaller than the specification's, or a string has no terminating NUL.
    Malformed
    // A class or byte order this build was configured not to read.
    Unsupported
    // A segment `load` was given lies in none of the regions it was given, or spans two.
    Unplaced

impl Display for ElfError
    display(self, out: *Writer, fmt: FormatSpec)
        val text = self match
            NotElf -> "not an ELF file"
            BadIdent -> "an ELF file of an unknown class or byte order"
            Truncated -> "the file ends inside something it describes"
            Malformed -> "a header or a string is malformed"
            Unsupported -> "an ELF file of a class or byte order this program was built not to read"
            Unplaced -> "a segment lies outside the memory it is to be loaded into"

        out.write(text.bytes)

@assert(option_elf32 || option_elf64, "the elf package reads no class: turn on elf32 or elf64")
@assert(option_little_endian || option_big_endian, "the elf package reads no byte order: turn on little_endian or big_endian")

// Whether a header says ELF-64, folded to a constant when only one class is read.
private wide(h: Header) -> bool = option_elf64 && (!option_elf32 || h.is64)

// Whether a header says big-endian, folded the same way.
private reversed(big: bool) -> bool = option_big_endian && (!option_little_endian || big)

// File types (`type`).
const ET_NONE: u32 = 0
const ET_REL: u32 = 1
const ET_EXEC: u32 = 2
const ET_DYN: u32 = 3
const ET_CORE: u32 = 4

// A few machines (`machine`); the full list is the gABI's.
const EM_386: u32 = 3
const EM_ARM: u32 = 40
const EM_X86_64: u32 = 62
const EM_AARCH64: u32 = 183
const EM_RISCV: u32 = 243

// Segment types (`Segment.kind`).
const PT_NULL: u32 = 0
const PT_LOAD: u32 = 1
const PT_DYNAMIC: u32 = 2
const PT_INTERP: u32 = 3
const PT_NOTE: u32 = 4
const PT_PHDR: u32 = 6
const PT_TLS: u32 = 7

// Segment permissions (`Segment.flags`).
const PF_X: u32 = 1
const PF_W: u32 = 2
const PF_R: u32 = 4

// Section types (`Section.kind`).
const SHT_NULL: u32 = 0
const SHT_PROGBITS: u32 = 1
const SHT_SYMTAB: u32 = 2
const SHT_STRTAB: u32 = 3
const SHT_RELA: u32 = 4
const SHT_NOBITS: u32 = 8
const SHT_REL: u32 = 9
const SHT_DYNSYM: u32 = 11

// Section flags (`Section.flags`).
const SHF_WRITE: u64 = 1
const SHF_ALLOC: u64 = 2
const SHF_EXECINSTR: u64 = 4

// Symbol bindings and types (`Symbol.bind`, `Symbol.kind`), and the special section indexes.
const STB_LOCAL: u32 = 0
const STB_GLOBAL: u32 = 1
const STB_WEAK: u32 = 2
const STT_NOTYPE: u32 = 0
const STT_OBJECT: u32 = 1
const STT_FUNC: u32 = 2
const STT_SECTION: u32 = 3
const STT_FILE: u32 = 4
const SHN_UNDEF: u32 = 0
const SHN_ABS: u32 = 0xFFF1

// The file header.
struct Header
    is64: bool
    big_endian: bool
    // The OS/ABI byte and its version, from the identification bytes.
    abi: u32
    abi_version: u32
    kind: u32
    machine: u32
    version: u32
    entry: u64
    phoff: u64
    shoff: u64
    flags: u32
    ehsize: u32
    phentsize: u32
    phnum: u32
    shentsize: u32
    shnum: u32
    shstrndx: u32

// A program header: one piece of the image as it is to be placed in memory.
struct Segment
    kind: u32
    flags: u32
    offset: u64
    vaddr: u64
    // Where it is loaded, which a program running from flash copies to `vaddr` itself.
    paddr: u64
    filesz: u64
    memsz: u64
    align: u64

// A section header, with its name looked up.
struct Section
    name: []const u8
    kind: u32
    flags: u64
    addr: u64
    offset: u64
    size: u64
    link: u32
    info: u32
    addralign: u64
    entsize: u64

// A symbol table entry, with its name looked up and its info byte split.
struct Symbol
    name: []const u8
    value: u64
    size: u64
    bind: u32
    kind: u32
    other: u32
    shndx: u32

// A file that `read` accepted.
struct Elf
    bytes: []const u8
    header: Header

    // The `i`th program header, `i` below `header.phnum`.
    segment(self, i: u32) -> Segment
        val at = usize(self.header.phoff) + usize(i) * usize(self.header.phentsize)
        val r = Fields(self.bytes, self.header.big_endian)

        if wide(self.header)
            return Segment(r.u32(at), r.u32(at + 4), r.u64(at + 8), r.u64(at + 16), r.u64(at + 24),
                r.u64(at + 32), r.u64(at + 40), r.u64(at + 48))

        Segment(r.u32(at), r.u32(at + 24), u64(r.u32(at + 4)), u64(r.u32(at + 8)), u64(r.u32(at + 12)),
            u64(r.u32(at + 16)), u64(r.u32(at + 20)), u64(r.u32(at + 28)))

    // Every program header, in the file's order.
    segments(self) -> Buf[Segment]
        var all: Buf[Segment] = buf()

        for i in 0..<self.header.phnum do all.push(self.segment(i))

        all

    // The bytes a segment takes from the file: `filesz` of them from `offset`. The rest of its
    // `memsz` is zero, and not in the file.
    segment_bytes(self, s: Segment) -> Result[[]const u8, ElfError] = self.span(s.offset, s.filesz)

    // The `i`th section header, `i` below `header.shnum`, with its name; a name the section-name
    // table cannot answer is empty.
    section(self, i: u32) -> Section
        val at = usize(self.header.shoff) + usize(i) * usize(self.header.shentsize)
        val r = Fields(self.bytes, self.header.big_endian)
        val name = self.section_name(r.u32(at))

        if wide(self.header)
            return Section(name, r.u32(at + 4), r.u64(at + 8), r.u64(at + 16), r.u64(at + 24),
                r.u64(at + 32), r.u32(at + 40), r.u32(at + 44), r.u64(at + 48), r.u64(at + 56))

        Section(name, r.u32(at + 4), u64(r.u32(at + 8)), u64(r.u32(at + 12)), u64(r.u32(at + 16)),
            u64(r.u32(at + 20)), r.u32(at + 24), r.u32(at + 28), u64(r.u32(at + 32)), u64(r.u32(at + 36)))

    // Every section header, in the file's order, the null section at index 0 included.
    sections(self) -> Buf[Section]
        var all: Buf[Section] = buf()

        for i in 0..<self.header.shnum do all.push(self.section(i))

        all

    // The first section called `name`.
    section_named(self, name: string) -> Option[Section]
        for i in 0..<self.header.shnum
            val s = self.section(i)

            if s.name == name.bytes then return Some(s)

        None

    // A section's contents; a section that takes no room in the file (`.bss`) has none.
    section_bytes(self, s: Section) -> Result[[]const u8, ElfError]
        if s.kind == SHT_NOBITS then return Ok([])

        self.span(s.offset, s.size)

    // The static symbol table (`SHT_SYMTAB`, `.symtab`) in its order, the null symbol at index 0
    // included; none when the file has none, as a stripped one does not.
    symbols(self) -> Result[Buf[Symbol], ElfError] = self.table_symbols(SHT_SYMTAB)

    // The dynamic symbol table (`SHT_DYNSYM`, `.dynsym`): what a shared library exports and imports,
    // which stripping leaves.
    dynamic_symbols(self) -> Result[Buf[Symbol], ElfError] = self.table_symbols(SHT_DYNSYM)

    private table_symbols(self, kind: u32) -> Result[Buf[Symbol], ElfError]
        var all: Buf[Symbol] = buf()
        var table: Option[Section] = None

        for i in 0..<self.header.shnum
            val s = self.section(i)

            if s.kind == kind
                table = Some(s)
                break

        val t = table match
            Some(t) -> t
            None -> return Ok(all)

        val entry: u64 = if wide(self.header) then 24 else 16

        if t.entsize < entry || t.link >= self.header.shnum then return Err(ElfError.Malformed)

        val rows = self.section_bytes(t)?
        val strings = self.section_bytes(self.section(t.link))?
        val r = Fields(rows, self.header.big_endian)

        for k in 0..<(t.size / t.entsize)
            val at = usize(k * t.entsize)
            val name = string_at(strings, r.u32(at))?

            if wide(self.header)
                val info = u32(rows[at + 4])

                all.push(Symbol(name, r.u64(at + 8), r.u64(at + 16), info >> 4, info & 15,
                    u32(rows[at + 5]), r.u16(at + 6)))
            else
                val info = u32(rows[at + 12])

                all.push(Symbol(name, u64(r.u32(at + 4)), u64(r.u32(at + 8)), info >> 4, info & 15,
                    u32(rows[at + 13]), r.u16(at + 14)))

        Ok(all)

    // The first symbol called `name`.
    symbol_named(self, name: string) -> Result[Option[Symbol], ElfError]
        for s in self.symbols()?.view()
            if s.name == name.bytes then return Ok(Some(s))

        Ok(None)

    // `size` bytes of the file from `offset`, if the file has them.
    private span(self, offset: u64, size: u64) -> Result[[]const u8, ElfError]
        if offset > u64(self.bytes.len) || size > u64(self.bytes.len) - offset then return Err(ElfError.Truncated)

        Ok(self.bytes[usize(offset)..<usize(offset + size)])

    private section_name(self, at: u32) -> []const u8
        if self.header.shstrndx == 0 || self.header.shstrndx >= self.header.shnum then return []

        val shstr = self.raw_section_range(self.header.shstrndx)

        string_at(shstr, at).unwrap_or([])

    // The contents of section `i` without looking up its name, which is what finding names needs; empty
    // where they are not in the file.
    private raw_section_range(self, i: u32) -> []const u8
        val at = usize(self.header.shoff) + usize(i) * usize(self.header.shentsize)
        val r = Fields(self.bytes, self.header.big_endian)
        val offset = if wide(self.header) then r.u64(at + 24) else u64(r.u32(at + 16))
        val size = if wide(self.header) then r.u64(at + 32) else u64(r.u32(at + 20))

        self.span(offset, size).unwrap_or([])

// Multi-byte fields of `bytes` in one byte order. Every caller has checked the range first.
private struct Fields
    bytes: []const u8
    big: bool

    u16(self, at: usize) -> u32
        val a = u32(self.bytes[at])
        val b = u32(self.bytes[at + 1])

        if reversed(self.big) then (a << 8) | b else a | (b << 8)

    u32(self, at: usize) -> u32
        val lo = self.u16(at)
        val hi = self.u16(at + 2)

        if reversed(self.big) then (lo << 16) | hi else lo | (hi << 16)

    u64(self, at: usize) -> u64
        val lo = u64(self.u32(at))
        val hi = u64(self.u32(at + 4))

        if reversed(self.big) then (lo << 32) | hi else lo | (hi << 32)

// The NUL-terminated string at `at` in a string table.
private string_at(table: []const u8, at: u32) -> Result[[]const u8, ElfError]
    if usize(at) >= table.len then return Err(ElfError.Malformed)

    var end = usize(at)

    while end < table.len && table[end] != 0 do end += 1

    if end == table.len then return Err(ElfError.Malformed)

    Ok(table[usize(at)..<end])

// Read the header of `bytes`, and check that its tables lie within them.
read(bytes: []const u8) -> Result[Elf, ElfError]
    if bytes.len < 16 || bytes[0] != 0x7F || bytes[1] != u8('E') || bytes[2] != u8('L') || bytes[3] != u8('F')
        return Err(ElfError.NotElf)

    val class = bytes[4]
    val data = bytes[5]

    if (class != 1 && class != 2) || (data != 1 && data != 2) then return Err(ElfError.BadIdent)
    if (class == 1 && !option_elf32) || (class == 2 && !option_elf64) then return Err(ElfError.Unsupported)
    if (data == 1 && !option_little_endian) || (data == 2 && !option_big_endian) then return Err(ElfError.Unsupported)

    val is64 = option_elf64 && (!option_elf32 || class == 2)
    val size: usize = if is64 then 64 else 52

    if bytes.len < size then return Err(ElfError.Truncated)

    val r = Fields(bytes, data == 2)

    val h = if is64
        Header(true, data == 2, u32(bytes[7]), u32(bytes[8]), r.u16(16), r.u16(18), r.u32(20), r.u64(24),
            r.u64(32), r.u64(40), r.u32(48), r.u16(52), r.u16(54), r.u16(56), r.u16(58), r.u16(60), r.u16(62))
    else
        Header(false, data == 2, u32(bytes[7]), u32(bytes[8]), r.u16(16), r.u16(18), r.u32(20),
            u64(r.u32(24)), u64(r.u32(28)), u64(r.u32(32)), r.u32(36), r.u16(40), r.u16(42), r.u16(44),
            r.u16(46), r.u16(48), r.u16(50))

    val phent: u32 = if is64 then 56 else 32
    val shent: u32 = if is64 then 64 else 40

    if h.phnum > 0
        if h.phentsize < phent then return Err(ElfError.Malformed)
        if !within(bytes, h.phoff, u64(h.phentsize) * u64(h.phnum)) then return Err(ElfError.Truncated)

    if h.shnum > 0
        if h.shentsize < shent then return Err(ElfError.Malformed)
        if !within(bytes, h.shoff, u64(h.shentsize) * u64(h.shnum)) then return Err(ElfError.Truncated)

    Ok(Elf(bytes, h))

private within(bytes: []const u8, offset: u64, size: u64) -> bool =
    offset <= u64(bytes.len) && size <= u64(bytes.len) - offset

// ---------------------------------------------------------------------------------------------------
// Loading.

// A piece of the caller's memory that `load` may write: `bytes` stands for the addresses from `base`.
struct Region
    base: u64
    bytes: []u8

// Where `load` puts a segment, as the `place_by` option chose.
address_of(s: Segment) -> u64 = if option_place_by == "virtual" then s.vaddr else s.paddr

// Whether `load` zeroes the part of a segment's memory the file has no bytes for (`.bss`). A segment
// placed by its run address is zeroed, as a loader does. One placed by its load address is zeroed only
// when that is also its run address; otherwise the load address is where the image is stored (flash),
// the program zeroes the tail itself at the run address, and writing zeros there would overwrite
// whatever the image keeps after the segment, as a debugger or flash programmer never does.
zeroes_tail(s: Segment) -> bool = option_place_by == "virtual" || s.paddr == s.vaddr

// How many bytes `load` writes for a segment, starting at its address.
extent_of(s: Segment) -> u64 = if zeroes_tail(s) then s.memsz else s.filesz

// Place every loadable segment of `e` in `regions`, each written part wholly inside one, its file bytes
// copied and, where `zeroes_tail` says so, the rest of its memory size zeroed; answer the entry point.
// A segment that writes nothing needs no region. Every segment is checked before any is written, so a
// refusal leaves the regions as they were.
load(e: Elf, regions: []Region) -> Result[u64, ElfError]
    val all = e.segments()

    for s in all.view()
        if s.kind != PT_LOAD || s.memsz == 0 then continue
        if s.filesz > s.memsz then return Err(ElfError.Malformed)

        e.segment_bytes(s)?

        if extent_of(s) == 0 then continue
        if region_of(regions, address_of(s), extent_of(s)).is_none() then return Err(ElfError.Unplaced)

    for s in all.view()
        if s.kind != PT_LOAD || s.memsz == 0 || extent_of(s) == 0 then continue

        val r = regions[region_of(regions, address_of(s), extent_of(s)).unwrap()]
        val from = e.segment_bytes(s)?
        val at = usize(address_of(s) - r.base)

        for i in 0..<from.len do r.bytes[at + i] = from[i]

        if zeroes_tail(s)
            for i in usize(s.filesz)..<usize(s.memsz) do r.bytes[at + i] = 0

    Ok(e.header.entry)

// The index of the region holding all of `size` bytes from `at`.
private region_of(regions: []Region, at: u64, size: u64) -> Option[usize]
    for i in 0..<regions.len
        val r = regions[i]

        if at >= r.base && at - r.base <= u64(r.bytes.len) && size <= u64(r.bytes.len) - (at - r.base)
            return Some(i)

    None
